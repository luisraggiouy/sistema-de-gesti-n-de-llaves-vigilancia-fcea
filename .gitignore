# ============================================================
# Sistema de Gestion de Llaves FCEA v2.0 - .gitignore
# ============================================================

# --- Logs ---
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- Build / deps ---
node_modules
dist
dist-ssr
*.local

# --- Editor ---
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# --- PocketBase (datos volatiles, no commitear) ---
pocketbase/pb_data/*.db-shm
pocketbase/pb_data/*.db-wal
pocketbase/pb_data/logs.db
pocketbase/pb_data/backups/
pocketbase/maintenance/logs/

# Backups locales generados por scripts/maintenance/backup_automatico.ps1
/backups/
/respaldo_pre_restauracion/

# El public/config.json del repo sirve de plantilla por defecto (modo desarrollo).
# Cada PC instalada lo sobrescribe localmente via INSTALAR.bat; ese sobrescrito
# no se commitea porque normalmente trabajamos en el repo en modo desarrollo.

# system_health.json lo regenera la tarea FCEA-Chequeo-Salud al login + cada 30 min
# en cada PC instalada (ver pocketbase/maintenance/check_system_health.ps1). Sus
# valores son especificos de la maquina (GB libres, dias desde backup, etc.), por
# lo que NO deben quedar trackeados. En instalaciones nuevas el componente
# SystemHealthIndicator muestra brevemente "Esperando primer chequeo..." hasta
# que la tarea programada genere el archivo (1-2 minutos tras el primer login).
public/system_health.json
dist/system_health.json

# Archivos sueltos de prueba / temporales
*.tmp
*.bak
test_copia.ps1

*.bak_parenfix

*.bak_parenfix2

*.bak_uacfix

scripts/pendrive/rename/

# Scripts sueltos experimentales de la sesion de rescate 26/07/2026.
# Los que sirven quedaron consolidados en _pendrive_tools/ y scripts/.
# Estos .ps1 en la raiz son one-shot y no deben commitearse.
/_buscar_node_portable.ps1
/_copiar_node_a_pendrive.ps1
/_validar_y_copiar.ps1
/_ver_pendrives.ps1
/_verificar_pendrive_final.ps1
/agregar_al_pendrive_D.ps1
/analizar_pendrive_viejo.ps1
/chequear_progreso_D.ps1
/GRABAR_KINGSTON_D.ps1
/GRABAR_PENDRIVE_NUEVO.ps1
/grabar_E_directo.ps1
/lanzar_grabar_pendrive.ps1
/levantar_dev.ps1
/ver_pendrives.ps1
/verificar_bundle.ps1
/verificar_final.ps1
/verificar_servicios.ps1
/wait_and_check.ps1
/wait_long.ps1
/ARRANCAR SISTEMA.bat
